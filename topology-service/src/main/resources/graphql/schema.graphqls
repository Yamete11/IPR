# Read API over the city_topology AGE graph (see TopologyGraphQLController).
# Vertices/edges are modelled generically; `properties` is a real JSON scalar
# (agtype -> JSON), a pass-through scalar defined in GraphQlConfig.
scalar JSON

type Vertex {
  id: ID!
  label: String!
  properties: JSON
}

type Edge {
  type: String!
  from: ID!
  to: ID!
  properties: JSON
}

type Query {
  # Full network view for the dashboard.
  vertices: [Vertex!]!
  edges: [Edge!]!

  # Dependency traversals: what loses service if `id` fails / what `id` relies on.
  dependents(id: ID!): [Vertex!]!
  dependencies(id: ID!): [Vertex!]!

  # Cypher aggregation over `dependents`: objects per label and apartments without service.
  impactSummary(id: ID!): ImpactSummary!

  # Directed paths from `from` to `to`, shortest first (at most `limit`, capped at 20).
  paths(from: ID!, to: ID!, limit: Int! = 5): [Path!]!

  # Hybrid SQL + Cypher: repair crews assigned to `id` or anything downstream of it.
  responsibleCrews(id: ID!): [Crew!]!
}

type LabelCount {
  label: String!
  count: Int!
}

type ImpactSummary {
  sourceId: ID!
  totalObjects: Int!
  apartments: Int!
  byLabel: [LabelCount!]!
}

type Path {
  length: Int!
  nodes: [Vertex!]!
}

type Crew {
  crewId: ID!
  name: String!
  phone: String
  assets: [String!]!
}
