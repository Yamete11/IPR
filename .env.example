# Copy to .env and adjust for local dev. `docker compose` reads .env automatically; the Java
# services and the simulator read the same names from the shell when run with ./gradlew bootRun
# or python (export them, or use a tool like direnv). deploy/scripts/up.* also reads .env to
# create the Kubernetes Secrets, so keep these names stable.

# --- PostgreSQL (both instances share one credential set) ------------------------------------
# Read by docker-compose.yml (age-db + timescaledb) and every Java service.
POSTGRES_DB=smartcity
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=smartcity
# Host the services connect to. Locally both DBs are on this host, on different ports.
POSTGRES_HOST=localhost
# Per-instance host overrides (default to POSTGRES_HOST); needed only when the two databases live
# on different hosts, e.g. two Services in Kubernetes.
#AGE_HOST=localhost
#TIMESCALE_HOST=localhost
# Host ports docker-compose.yml publishes; the services use the same names to connect.
AGE_PORT=5432
TIMESCALE_PORT=5433

# --- Kafka ------------------------------------------------------------------------------------
# Host port docker-compose.yml publishes for the broker.
KAFKA_PORT=9092
# Bootstrap address the services and the simulator connect to.
KAFKA_BOOTSTRAP=localhost:9092

# --- ai-incident-responder-service ----------------------------------------------------------
# Anthropic API key. Read straight from the environment by the SDK; leave empty to run in mock
# mode. Real calls are billed.
ANTHROPIC_API_KEY=
# true = deterministic offline planner (no key needed); false = call the Claude API.
AI_CLAUDE_MOCK=true
# Model used when AI_CLAUDE_MOCK=false.
AI_CLAUDE_MODEL=claude-opus-5-5
